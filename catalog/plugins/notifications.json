{
  "source": "omarchy.notifications",
  "id": "de.notifications",
  "name": "Benachrichtigungen",
  "replace": [
    {
      "file": "Service.qml",
      "find": "import \"NotificationLogic.js\" as NotificationLogic\n",
      "replace": "import \"NotificationLogic.js\" as NotificationLogic\nimport \"DeText.js\" as DeText\n",
      "count": 1
    },
    {
      "file": "Service.qml",
      "find": "              summary: cardSlot.summary\n              body: cardSlot.body\n",
      "replace": "              summary: cardSlot.app === \"omarchy-action\" ? DeText.tr(cardSlot.summary) : cardSlot.summary\n              body: cardSlot.app === \"omarchy-action\" ? DeText.trLines(cardSlot.body) : cardSlot.body\n",
      "count": 1
    },
    {
      "file": "Service.qml",
      "find": "summary: \"No recent notifications\"",
      "replace": "summary: \"Keine Benachrichtigungen im Verlauf\""
    },
    {
      "file": "manifest.json",
      "find": "\"description\": \"Notification daemon, popups, DND, and history\"",
      "replace": "\"description\": \"Benachrichtigungsdienst mit Einblendungen, „Nicht stören“ und Verlauf\""
    }
  ],
  "ignore": [
    "chrom",
    "brave",
    "vivaldi",
    "microsoft-edge",
    "opera",
    "img",
    "<br/>",
    "omarchy-action",
    "notify-send",
    "omarchy-glyph",
    "omarchy-exec-argv",
    "string",
    "app",
    "appIcon",
    "summary",
    "body",
    "image",
    "glyph",
    "execArgv",
    "urgency",
    "expireTimeout",
    "number",
    "boolean",
    ".json",
    "file://",
    "image://",
    "object",
    "top",
    "right",
    "undefined",
    "OMARCHY_PATH",
    "HOME",
    "notifications/",
    "history/",
    "images/",
    "left",
    "omarchy-notifications",
    "transient",
    "summaryChanged",
    "bodyChanged",
    "appNameChanged",
    "appIconChanged",
    "imageChanged",
    "urgencyChanged",
    "expireTimeoutChanged",
    "hintsChanged",
    "function",
    "dismiss",
    "expire",
    "default",
    "mkdir",
    "while (( $# >= 2 )); do\\n",
    "  if [[ -f $1 ]] && timeout 5 head -c 5242881 -- \\\"$1\\\" > \\\"$2.tmp\\\" 2>/dev/null &&\\n",
    "     (( $(stat -c%s -- \\\"$2.tmp\\\") <= 5242880 )); then mv -f -- \\\"$2.tmp\\\" \\\"$2\\\"; else rm -f -- \\\"$2.tmp\\\"; fi\\n",
    "  shift 2\\n",
    "done\\n",
    "bash",
    "mkdir -p \\\"$1\\\" \\\"$2\\\" || exit 0\\n",
    "dir=\\\"$1\\\" json=\\\"$3\\\" name=\\\"$4\\\"\\n",
    "shift 4\\n",
    "printf '%s\\\\n' \\\"$json\\\" > \\\"$dir/$name\\\"",
    "rm -f \\\"$1/$2.json\\\" \\\"$3/$2\\\"-*",
    "ls -1 \\\"$hist\\\" 2>/dev/null | sort -n | head -n \\\"-$limit\\\" | while IFS= read -r stale; do rm -f \\\"$hist/$stale\\\" \\\"$imgs/${stale%.json}\\\"-*; done",
    "mkdir -p \\\"$1\\\" || exit 0\\n",
    "hist=\\\"$1\\\" limit=\\\"$2\\\" imgs=\\\"$5\\\"\\n",
    "mv -f \\\"$4/$3\\\" \\\"$1/$3\\\" 2>/dev/null || exit 0\\n",
    "mkdir -p \\\"$1\\\" \\\"$5\\\" || exit 0\\n",
    "hist=\\\"$1\\\" limit=\\\"$2\\\" name=\\\"$3\\\" json=\\\"$4\\\" imgs=\\\"$5\\\"\\n",
    "shift 5\\n",
    "printf '%s\\\\n' \\\"$json\\\" > \\\"$hist/$name\\\" || exit 0\\n",
    "for f in \\\"$1\\\"/*.json; do\\n",
    "  [[ -e $f ]] || continue\\n",
    "  stale=\\\"${f##*/}\\\"\\n",
    "  rm -f \\\"$f\\\" \\\"$2/${stale%.json}\\\"-*\\n",
    "done",
    "for img in \\\"$3\\\"/*; do\\n",
    "  [[ -e $img ]] || continue\\n",
    "  [[ $img == *.tmp ]] && { rm -f -- \\\"$img\\\"; continue; }\\n",
    "  stem=\\\"${img##*/}\\\"\\n",
    "  stem=\\\"${stem%-*}\\\"\\n",
    "  [[ -e $1/$stem.json || -e $2/$stem.json ]] || rm -f \\\"$img\\\"\\n",
    "ok",
    "awk 1 \\\"$1\\\"/*.json 2>/dev/null || true",
    "notifications",
    "on",
    "off",
    "true",
    "yes",
    "none",
    "transparent",
    "border",
    "Liberation Sans"
  ],
  "generate": {
    "DeText.js": "messages"
  }
}
